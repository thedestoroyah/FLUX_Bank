<resources>
    <!-- Theme FLUX: chỉ giao diện sáng, font Inter -->
    <style name="Base.Theme.FLUXBank" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/flux_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/flux_emerald</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorError">@color/flux_error</item>
        <item name="android:colorBackground">@color/flux_bg</item>
        <item name="colorSurface">@color/flux_surface</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/flux_bg</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Flux.BottomSheet</item>
        <item name="materialCardViewStyle">@style/Widget.Flux.Card</item>
        <item name="textInputStyle">@style/Widget.Flux.TextField</item>
    </style>

    <style name="Theme.FLUXBank" parent="Base.Theme.FLUXBank" />
</resources>
