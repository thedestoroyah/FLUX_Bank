        android:bottomLeftRadius="@dimen/chat_bubble_radius"
        android:bottomRightRadius="@dimen/chat_bubble_radius"
        android:topLeftRadius="@dimen/chat_bubble_tail"
        android:topRightRadius="@dimen/chat_bubble_radius" />
</shape>
