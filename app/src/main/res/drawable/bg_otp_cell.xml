<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ô đang nhập: viền emerald -->
    <item android:state_activated="true">
        <shape>
            <solid android:color="@color/flux_surface" />
            <stroke android:width="1.5dp" android:color="@color/flux_emerald" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/flux_bg" />
            <stroke android:width="@dimen/stroke_hairline" android:color="@color/flux_border_hairline" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
