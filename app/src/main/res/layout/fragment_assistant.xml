<?xml version="1.0" encoding="utf-8"?>
<!-- Trợ lý FLUX (mockup F7 khung 1–3) -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/flux_bg"
    android:clickable="true"
    android:fitsSystemWindows="true"
    android:focusable="true">

    <include
        android:id="@+id/header"
        layout="@layout/view_screen_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/space_16"
        android:paddingEnd="@dimen/space_16"
        android:paddingBottom="@dimen/space_8"
        android:text="@string/assistant_subtitle"
        android:textAppearance="@style/TextAppearance.Flux.Caption"
        android:textColor="@color/flux_text_secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header" />

    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="@dimen/stroke_hairline"
        android:background="@color/flux_border_subtle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChat"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/space_16"
        android:paddingTop="@dimen/space_12"
        android:paddingEnd="@dimen/space_16"
        android:paddingBottom="@dimen/space_8"
        app:layout_constraintBottom_toTopOf="@id/inputBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider" />

    <!-- Trạng thái trống: lời chào, nhắc an toàn, chip gợi ý -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/emptyState"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/inputBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <TextView
                android:id="@+id/tvHello"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/space_8"
                android:gravity="center_vertical"
                android:textAppearance="@style/TextAppearance.Flux.TitleL"
                app:drawableStartCompat="@drawable/ic_sparkle"
                app:drawableTint="@color/cat_violet" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/assistant_intro"
                android:textAppearance="@style/TextAppearance.Flux.Body"
                android:textColor="@color/flux_text_secondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:background="@drawable/bg_note"
                android:drawablePadding="@dimen/space_8"
                android:gravity="center_vertical"
                android:padding="@dimen/space_12"
                android:text="@string/assistant_safety"
                android:textAppearance="@style/TextAppearance.Flux.Caption"
                android:textColor="@color/flux_text_secondary"
                app:drawableStartCompat="@drawable/ic_lock"
                app:drawableTint="@color/flux_text_secondary" />

            <TextView
                style="@style/Widget.Flux.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:text="@string/assistant_suggest_label" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/groupSuggest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTopup"
                    style="@style/Widget.Flux.FilterChip"
                    android:checkable="false"
                    android:text="@string/assistant_suggest_topup" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipElectricity"
                    style="@style/Widget.Flux.FilterChip"
                    android:checkable="false"
                    android:text="@string/assistant_suggest_electricity" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMonth"
                    style="@style/Widget.Flux.FilterChip"
                    android:checkable="false"
                    android:text="@string/assistant_suggest_month" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBranch"
                    style="@style/Widget.Flux.FilterChip"
                    android:checkable="false"
                    android:text="@string/assistant_suggest_branch" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Thanh nhập ở đáy -->
    <LinearLayout
        android:id="@+id/inputBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/flux_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_12"
        android:paddingTop="@dimen/space_8"
        android:paddingEnd="@dimen/space_12"
        android:paddingBottom="@dimen/space_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilMessage"
            style="@style/Widget.Flux.TextField"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/assistant_hint"
                android:imeOptions="actionSend"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLength="500"
                android:textAppearance="@style/TextAppearance.Flux.Body" />
        </com.google.android.material.textfield.TextInputLayout>

        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:layout_marginStart="@dimen/space_8"
            android:background="@drawable/bg_send_button"
            android:contentDescription="@string/assistant_send"
            android:src="@drawable/ic_arrow_up"
            app:tint="@color/flux_text_on_dark" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
