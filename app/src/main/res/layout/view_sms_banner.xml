<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Flux.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_12"
    android:clickable="true"
    android:focusable="true"
    app:cardElevation="6dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/touch_min"
        android:padding="@dimen/space_12">

        <ImageView
            android:id="@+id/ivSmsIcon"
            style="@style/Widget.Flux.IconTile"
            android:backgroundTint="@color/cat_emerald_bg"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_shield_check"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/cat_emerald" />

        <TextView
            android:id="@+id/tvSmsSender"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:text="@string/otp_sms_sender"
            android:textAppearance="@style/TextAppearance.Flux.Label"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivSmsIcon"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvSmsBody"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:layout_marginTop="@dimen/space_4"
            android:textAppearance="@style/TextAppearance.Flux.Body"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivSmsIcon"
            app:layout_constraintTop_toBottomOf="@id/tvSmsSender" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:layout_marginTop="@dimen/space_4"
            android:text="@string/otp_sms_tap_to_fill"
            android:textAppearance="@style/TextAppearance.Flux.Caption"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivSmsIcon"
            app:layout_constraintTop_toBottomOf="@id/tvSmsBody" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
