<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/flux_bg"
    tools:context=".ui.officer.OfficerMainActivity">

    <!-- Top Minimal Header Bar (Apple Minimalist - No Dark Banner) -->
    <TextView
        android:id="@+id/tvGreetingSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="32dp"
        android:text="Administrative Suite,"
        android:textColor="@color/flux_text_secondary"
        android:textSize="13sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvOfficerGreeting"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="2dp"
        android:text="Bank Officer"
        android:textColor="@color/flux_text_primary"
        android:textSize="24sp"
        android:textStyle="bold"
        android:letterSpacing="-0.02"
        app:layout_constraintTop_toBottomOf="@id/tvGreetingSub"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tvRoleBadge" />

    <!-- Officer Console Capsule -->
    <TextView
        android:id="@+id/tvRoleBadge"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_pill_capsule"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="Staff Console"
        android:textColor="@color/flux_gold_chip"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/tvOfficerGreeting"
        app:layout_constraintBottom_toBottomOf="@id/tvOfficerGreeting"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvOfficerEmail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="2dp"
        android:text="officer@fluxbank.com"
        android:textColor="@color/flux_text_tertiary"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/tvOfficerGreeting"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Operations Executive Bento Card (Pure White with Hairline Border) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardOperationsOverview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/flux_surface"
        app:strokeWidth="1dp"
        app:strokeColor="@color/flux_border_hairline"
        app:layout_constraintTop_toBottomOf="@id/tvOfficerEmail"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <ImageView
                android:id="@+id/ivOfficerBadgeIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_officer_badge"
                android:contentDescription="Officer Badge"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvOpsTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Governance &amp; Operations"
                android:textColor="@color/flux_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="@id/ivOfficerBadgeIcon"
                app:layout_constraintStart_toEndOf="@id/ivOfficerBadgeIcon"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tvOpsSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="2dp"
                android:text="Customer Onboarding, Data Modification &amp; Interest Rates"
                android:textColor="@color/flux_text_secondary"
                android:textSize="12sp"
                app:layout_constraintTop_toBottomOf="@id/tvOpsTitle"
                app:layout_constraintStart_toEndOf="@id/ivOfficerBadgeIcon"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tvOfficerUid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Officer Staff ID: -"
                android:textColor="@color/flux_text_secondary"
                android:textSize="12sp"
                app:layout_constraintTop_toBottomOf="@id/tvOpsSubtitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Officer Operations Shortcuts Label -->
    <TextView
        android:id="@+id/tvOfficerTasksLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="20dp"
        android:text="Management Actions"
        android:textColor="@color/flux_text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/cardOperationsOverview"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bento Tile 1: Create Account -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTaskCreateAccount"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="@color/flux_surface"
        app:strokeWidth="1dp"
        app:strokeColor="@color/flux_border_hairline"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintTop_toBottomOf="@id/tvOfficerTasksLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/cardTaskRates">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvCreateAccountTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New Client"
                android:textColor="@color/flux_text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/tvCreateAccountSub"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintVertical_chainStyle="packed" />

            <TextView
                android:id="@+id/tvCreateAccountSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Create Account"
                android:textColor="@color/flux_accent_blue"
                android:textSize="10sp"
                app:layout_constraintTop_toBottomOf="@id/tvCreateAccountTitle"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bento Tile 2: Modify Rates -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTaskRates"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="@color/flux_surface"
        app:strokeWidth="1dp"
        app:strokeColor="@color/flux_border_hairline"
        app:layout_constraintTop_toBottomOf="@id/tvOfficerTasksLabel"
        app:layout_constraintStart_toEndOf="@id/cardTaskCreateAccount"
        app:layout_constraintEnd_toStartOf="@id/cardTaskEkyc">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvRatesTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Saving Rates"
                android:textColor="@color/flux_text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/tvRatesSub"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintVertical_chainStyle="packed" />

            <TextView
                android:id="@+id/tvRatesSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Update Policy"
                android:textColor="@color/flux_gold_chip"
                android:textSize="10sp"
                app:layout_constraintTop_toBottomOf="@id/tvRatesTitle"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bento Tile 3: eKYC Verification -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTaskEkyc"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="20dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="@color/flux_surface"
        app:strokeWidth="1dp"
        app:strokeColor="@color/flux_border_hairline"
        app:layout_constraintTop_toBottomOf="@id/tvOfficerTasksLabel"
        app:layout_constraintStart_toEndOf="@id/cardTaskRates"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvEkycTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="eKYC Review"
                android:textColor="@color/flux_text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/tvEkycSub"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintVertical_chainStyle="packed" />

            <TextView
                android:id="@+id/tvEkycSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Biometric Queue"
                android:textColor="@color/flux_emerald"
                android:textSize="10sp"
                app:layout_constraintTop_toBottomOf="@id/tvEkycTitle"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Privileges Details Bento Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardOfficerPrivileges"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="@color/flux_surface"
        app:strokeWidth="1dp"
        app:strokeColor="@color/flux_border_hairline"
        app:layout_constraintTop_toBottomOf="@id/cardTaskCreateAccount"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="18dp">

            <TextView
                android:id="@+id/tvPrivilegesTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Authorized Management Privileges"
                android:textColor="@color/flux_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tvPrivilegesDesc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="• Create customer checking, saving, &amp; mortgage accounts\n• Modify customer records upon verified customer request\n• Adjust profitable interest rates for saving accounts\n• Verify customer biometric identity via eKYC face &amp; ID card"
                android:textColor="@color/flux_text_secondary"
                android:textSize="12sp"
                android:lineSpacingExtra="4dp"
                app:layout_constraintTop_toBottomOf="@id/tvPrivilegesTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Sign Out Button (Sleek Outlined Style) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogout"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="24dp"
        android:text="Sign Out of Console"
        android:textColor="@color/flux_error"
        app:strokeColor="@color/flux_error"
        app:cornerRadius="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
