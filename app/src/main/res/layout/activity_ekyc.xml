<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/flux_bg"
    tools:context=".ui.customer.EkycActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="32dp">

        <!-- Top Navigation Bar -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_pill_capsule"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Identity Verification"
            android:textColor="@color/flux_text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02"
            app:layout_constraintTop_toTopOf="@id/btnBack"
            app:layout_constraintBottom_toBottomOf="@id/btnBack"
            app:layout_constraintStart_toEndOf="@id/btnBack" />

        <!-- Status Capsule Banner -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardKycStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/flux_surface"
            app:strokeWidth="1dp"
            app:strokeColor="@color/flux_border_hairline"
            app:layout_constraintTop_toBottomOf="@id/btnBack"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/ivStatusDot"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_security_shield"
                    app:tint="@color/flux_accent_blue"
                    android:contentDescription="@null"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tvKycStatusBadge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Status: Pending Document Submission"
                    android:textColor="@color/flux_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="@id/ivStatusDot"
                    app:layout_constraintBottom_toBottomOf="@id/ivStatusDot"
                    app:layout_constraintStart_toEndOf="@id/ivStatusDot"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/tvKycStatusDesc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Complete steps 1 and 2 below to unlock high-value transactions and 2FA biometric features."
                    android:textColor="@color/flux_text_secondary"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp"
                    app:layout_constraintTop_toBottomOf="@id/tvKycStatusBadge"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Step 1 Bento Card: ID Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStepId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/flux_surface"
            app:strokeWidth="1dp"
            app:strokeColor="@color/flux_border_hairline"
            app:layout_constraintTop_toBottomOf="@id/cardKycStatus"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvStep1Tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STEP 1 OF 2"
                    android:textColor="@color/flux_accent_blue"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tvStep1Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Citizen ID / Passport"
                    android:textColor="@color/flux_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/tvStep1Tag"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/tvStep1Desc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Take a clear photo of the front of your National ID or Passport."
                    android:textColor="@color/flux_text_secondary"
                    android:textSize="12sp"
                    app:layout_constraintTop_toBottomOf="@id/tvStep1Title"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- ID Card Image Preview Box -->
                <ImageView
                    android:id="@+id/ivIdPreview"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_marginTop="14dp"
                    android:background="#F8FAFC"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_id_card"
                    android:contentDescription="ID Card Photo Preview"
                    app:layout_constraintTop_toBottomOf="@id/tvStep1Desc"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Capture ID Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCaptureId"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="Capture ID Photo"
                    android:textColor="@color/flux_primary"
                    app:strokeColor="@color/flux_border_hairline"
                    app:icon="@drawable/ic_camera"
                    app:iconTint="@color/flux_primary"
                    app:cornerRadius="12dp"
                    app:layout_constraintTop_toBottomOf="@id/ivIdPreview"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Step 2 Bento Card: Face Selfie -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStepFace"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/flux_surface"
            app:strokeWidth="1dp"
            app:strokeColor="@color/flux_border_hairline"
            app:layout_constraintTop_toBottomOf="@id/cardStepId"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvStep2Tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STEP 2 OF 2"
                    android:textColor="@color/flux_emerald"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tvStep2Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Live Face Biometric Selfie"
                    android:textColor="@color/flux_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/tvStep2Tag"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/tvStep2Desc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Position your face inside the frame in a well-lit area."
                    android:textColor="@color/flux_text_secondary"
                    android:textSize="12sp"
                    app:layout_constraintTop_toBottomOf="@id/tvStep2Title"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Face Image Preview Box -->
                <ImageView
                    android:id="@+id/ivFacePreview"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_marginTop="14dp"
                    android:background="#F8FAFC"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_face_scan"
                    android:contentDescription="Face Selfie Preview"
                    app:layout_constraintTop_toBottomOf="@id/tvStep2Desc"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Capture Face Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCaptureFace"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="Capture Face Selfie"
                    android:textColor="@color/flux_primary"
                    app:strokeColor="@color/flux_border_hairline"
                    app:icon="@drawable/ic_camera"
                    app:iconTint="@color/flux_primary"
                    app:cornerRadius="12dp"
                    app:layout_constraintTop_toBottomOf="@id/ivFacePreview"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Progress Indicator -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:indeterminateTint="@color/flux_primary"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/cardStepFace"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Submit Button (Apple-Style Obsidian Black Button) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitEkyc"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="16dp"
            android:text="Submit for Officer Review"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/flux_primary"
            app:cornerRadius="14dp"
            app:layout_constraintTop_toBottomOf="@id/progressBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>

