<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/flux_bg"
    tools:context=".ui.officer.OfficerEkycReviewActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="32dp">

        <!-- Top Navigation Bar -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_pill_capsule"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="eKYC Verification Desk"
            android:textColor="@color/flux_text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02"
            app:layout_constraintTop_toTopOf="@id/btnBack"
            app:layout_constraintBottom_toBottomOf="@id/btnBack"
            app:layout_constraintStart_toEndOf="@id/btnBack" />

        <!-- Queue Status Pill -->
        <TextView
            android:id="@+id/tvQueueCount"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_pill_capsule"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Queue: 0"
            android:textColor="@color/flux_gold_chip"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="@id/tvHeaderTitle"
            app:layout_constraintBottom_toBottomOf="@id/tvHeaderTitle"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Empty State View -->
        <TextView
            android:id="@+id/tvEmptyState"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginTop="80dp"
            android:gravity="center"
            android:text="No pending customer eKYC submissions in the review queue.\n\nAll submitted customer identity files are up to date."
            android:textColor="@color/flux_text_secondary"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/btnBack"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Current Review Card (Apple Bento Box) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardReviewItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/flux_surface"
            app:strokeWidth="1dp"
            app:strokeColor="@color/flux_border_hairline"
            app:layout_constraintTop_toBottomOf="@id/btnBack"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvApplicantTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="APPLICANT DOSSIER"
                    android:textColor="@color/flux_accent_blue"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tvCustomerName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Customer Name"
                    android:textColor="@color/flux_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/tvApplicantTag"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/tvCustomerEmail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="email@domain.com"
                    android:textColor="@color/flux_text_secondary"
                    android:textSize="12sp"
                    app:layout_constraintTop_toBottomOf="@id/tvCustomerName"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/tvCustomerUid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="UID: -"
                    android:textColor="@color/flux_text_tertiary"
                    android:textSize="11sp"
                    app:layout_constraintTop_toBottomOf="@id/tvCustomerEmail"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <View
                    android:id="@+id/divider1"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:background="@color/flux_border_subtle"
                    app:layout_constraintTop_toBottomOf="@id/tvCustomerUid"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Photo 1: ID Card -->
                <TextView
                    android:id="@+id/tvIdLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="National ID / Passport"
                    android:textColor="@color/flux_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/divider1"
                    app:layout_constraintStart_toStartOf="parent" />

                <ImageView
                    android:id="@+id/ivReviewIdCard"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_marginTop="6dp"
                    android:background="#F8FAFC"
                    android:scaleType="centerCrop"
                    android:contentDescription="Review ID Card"
                    app:layout_constraintTop_toBottomOf="@id/tvIdLabel"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Photo 2: Face Selfie -->
                <TextView
                    android:id="@+id/tvFaceLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Live Face Biometric Photo"
                    android:textColor="@color/flux_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/ivReviewIdCard"
                    app:layout_constraintStart_toStartOf="parent" />

                <ImageView
                    android:id="@+id/ivReviewFace"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_marginTop="6dp"
                    android:background="#F8FAFC"
                    android:scaleType="centerCrop"
                    android:contentDescription="Review Face Photo"
                    app:layout_constraintTop_toBottomOf="@id/tvFaceLabel"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Decision Action Buttons (Reject / Approve) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReject"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="8dp"
                    android:text="Decline"
                    android:textColor="@color/flux_error"
                    app:strokeColor="@color/flux_error"
                    app:cornerRadius="12dp"
                    app:layout_constraintTop_toBottomOf="@id/ivReviewFace"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btnApprove" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnApprove"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginStart="8dp"
                    android:text="Approve eKYC"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:backgroundTint="@color/flux_emerald"
                    app:cornerRadius="12dp"
                    app:layout_constraintTop_toBottomOf="@id/ivReviewFace"
                    app:layout_constraintStart_toEndOf="@id/btnReject"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Progress Indicator -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="24dp"
            android:indeterminateTint="@color/flux_primary"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/cardReviewItem"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>

