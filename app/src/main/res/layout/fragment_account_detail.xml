<?xml version="1.0" encoding="utf-8"?>
<!-- Chi tiết tài khoản (mockup màn 1–2): phần Checking/Saving và phần Mortgage ẩn/hiện theo loại -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/flux_bg"
    android:clickable="true"
    android:fitsSystemWindows="true"
    android:focusable="true">

    <include
        android:id="@+id/header"
        layout="@layout/view_screen_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_16"
            android:paddingEnd="@dimen/space_16"
            android:paddingBottom="@dimen/space_24">

            <!-- Checking / Saving -->
            <LinearLayout
                android:id="@+id/groupBalance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <include
                        android:id="@+id/accountCard"
                        layout="@layout/item_account_card"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintDimensionRatio="1.586:1"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopy"
                    style="@style/Widget.Flux.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardInterest"
                    style="@style/Widget.Flux.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/rowsInterest"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/space_16"
                        android:paddingTop="@dimen/space_4"
                        android:paddingEnd="@dimen/space_16"
                        android:paddingBottom="@dimen/space_4" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDeposit"
                        style="@style/Widget.Flux.Button.Primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_8"
                        android:layout_weight="1"
                        android:text="@string/util_deposit"
                        app:icon="@drawable/ic_plus" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnWithdraw"
                        style="@style/Widget.Flux.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:layout_weight="1"
                        android:text="@string/util_withdraw"
                        app:icon="@drawable/ic_arrow_down" />
                </LinearLayout>

                <TextView
                    style="@style/Widget.Flux.SectionLabel"
                    android:text="@string/home_recent" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Flux.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/space_16"
                        android:paddingEnd="@dimen/space_16">

                        <TextView
                            android:id="@+id/tvNoTx"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingTop="@dimen/space_16"
                            android:paddingBottom="@dimen/space_16"
                            android:text="@string/history_empty"
                            android:textAppearance="@style/TextAppearance.Flux.Caption" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvRecent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Mortgage -->
            <LinearLayout
                android:id="@+id/groupMortgage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Flux.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_16">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/card_outstanding"
                            android:textAppearance="@style/TextAppearance.Flux.Caption" />

                        <TextView
                            android:id="@+id/tvOutstanding"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Flux.Amount" />

                        <TextView
                            android:id="@+id/tvLoanMeta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Flux.Caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/groupFrequency"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMonthly"
                        style="@style/Widget.Flux.FilterChip"
                        android:checked="true"
                        android:text="@string/mortgage_monthly" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipBiweekly"
                        style="@style/Widget.Flux.FilterChip"
                        android:text="@string/mortgage_biweekly" />
                </com.google.android.material.chip.ChipGroup>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Flux.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_16">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mortgage_installment"
                            android:textAppearance="@style/TextAppearance.Flux.Caption" />

                        <TextView
                            android:id="@+id/tvInstallment"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Flux.Amount" />

                        <TextView
                            android:id="@+id/tvNextDue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_8"
                            android:textAppearance="@style/TextAppearance.Flux.Body" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Flux.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12">

                    <LinearLayout
                        android:id="@+id/rowsLoan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/space_16"
                        android:paddingTop="@dimen/space_4"
                        android:paddingEnd="@dimen/space_16"
                        android:paddingBottom="@dimen/space_4" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
