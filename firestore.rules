rules_version = '2';

// Security Rules của FLUX Bank (gói Spark, không có server).
// Deploy: Firebase Console → Firestore Database → Rules → dán nội dung file này → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isOfficer() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'BANK_OFFICER';
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Khách chỉ tự sửa: SĐT, địa chỉ, ảnh, cờ sinh trắc học, tắt cờ đổi mật khẩu,
    // và chuyển eKYC sang PENDING khi nộp hồ sơ (từ NOT_SUBMITTED hoặc REJECTED).
    function ownerUpdateAllowed() {
      let keys = changedKeys();
      let data = request.resource.data;
      return keys.hasOnly(['phoneNumber', 'address', 'avatarBase64', 'biometricEnabled',
                           'mustChangePassword', 'kycStatus', 'kycRejectReason'])
        && (!keys.hasAny(['mustChangePassword']) || data.mustChangePassword == false)
        && (!keys.hasAny(['kycStatus', 'kycRejectReason'])
            || (data.kycStatus == 'PENDING'
                && data.kycRejectReason == null
                && resource.data.kycStatus in ['NOT_SUBMITTED', 'REJECTED']));
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isOfficer();
      allow create, delete: if isOfficer();
      allow update: if isOfficer() || (isOwner(uid) && ownerUpdateAllowed());
    }

    // Chỉ mục SĐT -> uid: bảo đảm SĐT duy nhất (create thất bại nếu đã có) và để tra người nhận.
    // Chỉ cho đọc từng mục (get), không cho liệt kê.
    match /phoneIndex/{phone} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if isOfficer()
        || (signedIn()
            && request.resource.data.uid == request.auth.uid
            && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.phoneNumber == phone);
      allow delete: if isOfficer() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if false;
    }

    // Khách chỉ được (nộp lại) hồ sơ khi đang chưa nộp hoặc bị từ chối, và cùng batch phải chuyển users.kycStatus
    // sang PENDING — không thể thay ảnh/embedding hay xoá dấu vết duyệt sau khi đã được duyệt.
    match /kyc/{uid} {
      allow read: if isOwner(uid) || isOfficer();
      allow create, update: if isOfficer()
        || (isOwner(uid)
            && request.resource.data.submittedBy == request.auth.uid
            && request.resource.data.reviewedBy == null
            && get(/databases/$(database)/documents/users/$(uid)).data.kycStatus in ['NOT_SUBMITTED', 'REJECTED']
            && getAfter(/databases/$(database)/documents/users/$(uid)).data.kycStatus == 'PENDING');
      allow delete: if false;
    }

    // Khách chỉ đổi số dư Checking/Saving của chính mình, và chỉ khi cùng lúc tạo một giao dịch mới khớp:
    // lastTxId trỏ tới giao dịch chưa tồn tại trước đó, cùng tài khoản, balanceAfter = số dư mới, đúng phép cộng/trừ.
    function ownerMoneyMoveAllowed(accountId) {
      let newData = request.resource.data;
      let txPath = /databases/$(database)/documents/transactions/$(newData.lastTxId);
      let tx = getAfter(txPath).data;
      return signedIn()
        && resource.data.ownerUid == request.auth.uid
        && resource.data.type in ['CHECKING', 'SAVING']
        && changedKeys().hasOnly(['balance', 'lastTxId'])
        && newData.balance is int
        && !exists(txPath)
        && tx.accountId == accountId
        && tx.ownerUid == request.auth.uid
        && tx.balanceAfter == newData.balance
        && ((tx.type == 'DEPOSIT' && newData.balance == resource.data.balance + tx.amount)
            || (tx.type == 'WITHDRAW' && newData.balance == resource.data.balance - tx.amount && newData.balance >= 0));
    }

    function validNewAccount() {
      let data = request.resource.data;
      return data.balance is int && data.balance >= 0
        && (data.type != 'MORTGAGE'
            || (data.loanAmount is int && data.loanAmount > 0 && data.termMonths >= 1 && data.termMonths <= 360));
    }

    match /accounts/{accountId} {
      allow read: if isOfficer() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if isOfficer() && validNewAccount();
      allow update: if ownerMoneyMoveAllowed(accountId);
      allow delete: if false;
    }

    // Giao dịch chỉ được tạo cùng batch với lần đổi số dư (tài khoản sau khi ghi phải trỏ lastTxId về đây).
    match /transactions/{txId} {
      allow read: if isOfficer() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.type in ['DEPOSIT', 'WITHDRAW']
        && request.resource.data.amount is int
        && request.resource.data.amount >= 10000
        && (request.resource.data.type != 'DEPOSIT' || request.resource.data.amount <= 100000000)
        && getAfter(/databases/$(database)/documents/accounts/$(request.resource.data.accountId)).data.lastTxId == txId;
      allow update, delete: if false;
    }

    // Lãi suất chung: ai đăng nhập cũng đọc được, chỉ nhân viên sửa, mỗi mức trong (0, 30].
    match /config/rates {
      allow read: if signedIn();
      allow write: if isOfficer()
        && request.resource.data.savingRate is number
        && request.resource.data.savingRate > 0 && request.resource.data.savingRate <= 30
        && request.resource.data.mortgageRate is number
        && request.resource.data.mortgageRate > 0 && request.resource.data.mortgageRate <= 30;
    }
  }
}
