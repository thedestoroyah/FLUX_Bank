  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Nút hành động chính, luôn màu obsidian.",
      "html": "<button class=\"ds-btn-primary\">Tiếp tục</button>",
      "css": ".ds-btn-primary{font-family: Inter, Roboto, sans-serif;background:#0A0D12;color:#fff;height:52px;padding:0 24px;border:none;border-radius:14px;font-size:16px;font-weight:600;transition:background .15s}.ds-btn-primary:hover{background:#1E293B}.ds-btn-primary:focus-visible{outline:2px solid #10B981;outline-offset:2px}.ds-btn-primary:disabled{opacity:.35}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Hành động phụ: nền trắng viền hairline.",
      "html": "<button class=\"ds-btn-secondary\">Huỷ</button>",
      "css": ".ds-btn-secondary{font-family: Inter, Roboto, sans-serif;background:#fff;color:#0F172A;height:52px;padding:0 24px;border:1px solid #E5E7EB;border-radius:14px;font-size:16px;font-weight:600}.ds-btn-secondary:hover{background:#F9FAFB}.ds-btn-secondary:focus-visible{outline:2px solid #10B981;outline-offset:2px}"
    },
    {
      "name": "Destructive Button",
      "kind": "button",
      "refersTo": "button-destructive",
      "description": "Xoá, từ chối, đăng xuất.",
      "html": "<button class=\"ds-btn-danger\">Từ chối</button>",
      "css": ".ds-btn-danger{font-family: Inter, Roboto, sans-serif;background:#fff;color:#DC2626;height:52px;padding:0 24px;border:1px solid #EF4444;border-radius:14px;font-size:16px;font-weight:600}.ds-btn-danger:hover{background:#FEF2F2}.ds-btn-danger:focus-visible{outline:2px solid #EF4444;outline-offset:2px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "text-field",
      "description": "Ô nhập Material Outlined, focus viền emerald 1.5dp.",
      "html": "<label class=\"ds-field\"><span>Số tài khoản</span><input placeholder=\"8868 xxxx xxxx\"></label>",
      "css": ".ds-field{font-family: Inter, Roboto, sans-serif;display:flex;flex-direction:column;gap:4px;font-size:12px;color:#64748B}.ds-field input{font-family: Inter, Roboto, sans-serif;height:52px;padding:0 16px;border:1px solid #E5E7EB;border-radius:14px;background:#fff;font-size:14px;color:#0F172A;outline:none}.ds-field input:focus{border:1.5px solid #10B981}.ds-field:focus-within span{color:#059669}"
    },
    {
      "name": "Filter Chip",
      "kind": "chip",
      "refersTo": "filter-chip",
      "description": "Chip lọc: chọn = nền đen chữ trắng.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip is-on\">Tất cả</button><button class=\"ds-chip\">Tiền vào</button><button class=\"ds-chip\">Tiền ra</button></div>",
      "css": ".ds-chips{display:flex;gap:8px}.ds-chip{font-family: Inter, Roboto, sans-serif;height:36px;padding:0 16px;border:1px solid #E5E7EB;border-radius:999px;background:#fff;color:#0F172A;font-size:13px;font-weight:500}.ds-chip.is-on{background:#0A0D12;color:#fff;border-color:#0A0D12}.ds-chip:focus-visible{outline:2px solid #10B981;outline-offset:2px}"
    },
    {
      "name": "Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Tile bento phẳng, viền hairline, không bóng.",
      "html": "<div class=\"ds-card\"><div class=\"ds-card-label\">GIAO DỊCH GẦN ĐÂY</div><div class=\"ds-card-row\"><span>Nhận từ TRAN THI BINH</span><b>+500.000 ₫</b></div></div>",
      "css": ".ds-card{font-family: Inter, Roboto, sans-serif;background:#fff;border:1px solid #E5E7EB;border-radius:20px;padding:16px;width:300px}.ds-card-label{font-size:12px;font-weight:700;letter-spacing:.04em;color:#94A3B8;margin-bottom:8px}.ds-card-row{display:flex;justify-content:space-between;font-size:14px;color:#0F172A}.ds-card-row b{color:#059669;font-weight:600;font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Utility Tile",
      "kind": "custom",
      "refersTo": "icon-tile",
      "description": "Ô tiện ích: nền cat-*-bg 10%, icon duotone màu nhóm.",
      "html": "<div class=\"ds-util\"><div class=\"ds-util-icon\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 256 256\"><path d=\"M96 240l16-80-64-24L160 16l-16 80 64 24z\" fill=\"#D97706\" opacity=\".2\"/><path d=\"M96 240l16-80-64-24L160 16l-16 80 64 24z\" fill=\"none\" stroke=\"#D97706\" stroke-width=\"16\" stroke-linejoin=\"round\"/></svg></div><span>Tiền điện</span></div>",
      "css": ".ds-util{font-family: Inter, Roboto, sans-serif;display:flex;flex-direction:column;align-items:center;gap:8px;width:72px;font-size:13px;font-weight:500;color:#0F172A}.ds-util-icon{width:48px;height:48px;border-radius:14px;background:#D977061A;display:grid;place-items:center;transition:transform .15s}.ds-util:hover .ds-util-icon{transform:scale(1.05)}"
    },
    {
      "name": "Bottom Navigation",
      "kind": "nav",
      "refersTo": "bottom-nav",
      "description": "Thanh tab 5 mục, nút QR emerald nổi ở giữa.",
      "html": "<nav class=\"ds-nav\"><a class=\"is-on\">Trang chủ</a><a>Chuyển tiền</a><span class=\"ds-qr\">QR</span><a>Lịch sử</a><a>Cá nhân</a></nav>",
      "css": ".ds-nav{font-family: Inter, Roboto, sans-serif;display:flex;align-items:center;justify-content:space-around;background:#fff;height:64px;width:360px;border-top:1px solid #F1F3F5}.ds-nav a{font-size:12px;color:#94A3B8;cursor:pointer}.ds-nav a.is-on{color:#059669;font-weight:600}.ds-nav a:hover{color:#0F172A}.ds-qr{width:52px;height:52px;border-radius:18px;background:#10B981;color:#fff;display:grid;place-items:center;font-weight:700;box-shadow:0 8px 20px rgba(16,185,129,.35);transform:translateY(-12px)}"
    },
    {
      "name": "Titanium Card",
