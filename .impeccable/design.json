      "css": ".ds-mint{background:linear-gradient(180deg,#E7F8EF,#F5F5F7);padding:24px 16px}.ds-ti{font-family: Inter, Roboto, sans-serif;aspect-ratio:1.586;width:300px;border-radius:24px;border:1px solid #D1D5DB;background:linear-gradient(135deg,#FFFFFF,#F0F1F3,#E1E3E8);box-shadow:0 8px 24px rgba(16,185,129,.18);padding:20px;box-sizing:border-box;display:flex;flex-direction:column;justify-content:flex-end;gap:4px;color:#0F172A}.ds-ti small{font-size:12px;color:#64748B}.ds-ti b{font-size:28px;letter-spacing:-.02em;font-variant-numeric:tabular-nums}"
    },
